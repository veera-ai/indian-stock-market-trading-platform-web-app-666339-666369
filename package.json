{
  "name": "indian-stock-market-trading-platform-web-app",
  "version": "0.1.0",
  "private": true,
  "description": "React monorepo baseline for an Indian stock market trading platform with TypeScript, ESLint (strict), and Prettier configured.",
  "keywords": [
    "react",
    "typescript",
    "eslint",
    "prettier",
    "trading",
    "stock-market",
    "india"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "eslint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "eslint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "prettier": "prettier --check .",
    "prettier:write": "prettier --write .",
    "lint": "npm run eslint && npm run prettier",
    "lint:fix": "npm run eslint:fix && npm run prettier:write",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run lint",
    "depcheck": "depcheck",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --open",
    "start": "vite",
    "postinstall": "node -e \"console.log('Dependencies installed. Run npm scripts from indian-stock-market-web-app container directory.')\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
