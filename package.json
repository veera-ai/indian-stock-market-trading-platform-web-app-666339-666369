{
  "name": "indian-stock-market-trading-platform-web-app",
  "version": "0.1.0",
  "private": true,
  "description": "React monorepo baseline for an Indian stock market trading platform with TypeScript, ESLint (strict), and Prettier configured.",
  "keywords": [
    "react",
    "typescript",
    "eslint",
    "prettier",
    "trading",
    "stock-market",
    "india"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" && prettier --check .",
    "type-check": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "depcheck": "depcheck",
    "build": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
